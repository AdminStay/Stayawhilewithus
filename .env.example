# Copy to .env(.local) and fill in real values. Never commit .env files.

# ── Database (Supabase Postgres in production; local Postgres in dev) ──────
# Pooled connection (pgbouncer, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/staywhile_dev"
# Direct connection (port 5432) — used by Prisma Migrate only.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/staywhile_dev"

# ── Clerk (authentication) ──────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ── n8n (workflow orchestration) ────────────────────────────────────────────
N8N_BASE_URL="https://n8n.staywhile.internal"
N8N_WEBHOOK_SHARED_SECRET="change-me"
N8N_INBOUND_WEBHOOK_SHARED_SECRET="change-me-too"

# ── Claude API (AI layer) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── Integrations (placeholders — filled in as each is implemented) ─────────
OWNERREZ_API_TOKEN=""
AIRBNB_API_TOKEN=""
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""
ASANA_ACCESS_TOKEN=""
NOTION_API_KEY=""
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GOOGLE_VOICE_API_KEY=""
YALE_API_KEY=""
AUGUST_API_KEY=""
NEST_API_KEY=""
ECOBEE_API_KEY=""
CIELO_API_KEY=""

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

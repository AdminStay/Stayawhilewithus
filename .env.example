# Copy to .env(.local) and fill in real values. Never commit .env files.

# ── Database (Supabase Postgres in production; local Postgres in dev) ──────
# Pooled connection (pgbouncer, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/staywhile_dev"
# Direct connection (port 5432) — used by Prisma Migrate only.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/staywhile_dev"

# ── Clerk (authentication) ──────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ── n8n (workflow orchestration) ────────────────────────────────────────────
N8N_BASE_URL="https://n8n.staywhile.internal"
N8N_WEBHOOK_SHARED_SECRET="change-me"
N8N_INBOUND_WEBHOOK_SHARED_SECRET="change-me-too"

# ── AI platform (packages/ai) ───────────────────────────────────────────────
# AI_MODEL_PROVIDER selects a registered model provider by name (see
# packages/ai/src/provider/) — "claude" is the only one currently
# implemented (the only vendor StayWhile requires) and the default.
# Optional; only needed to override the default.
AI_MODEL_PROVIDER="claude"
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL=""
ANTHROPIC_MAX_TOKENS=""

# ── Integrations (placeholders — filled in as each is implemented) ─────────
# OwnerRez v2 API uses HTTP Basic Auth: username + token, not a bearer token.
OWNERREZ_USERNAME=""
OWNERREZ_API_TOKEN=""
AIRBNB_API_TOKEN=""
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""
ASANA_ACCESS_TOKEN=""
NOTION_API_KEY=""
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GOOGLE_VOICE_API_KEY=""
YALE_API_KEY=""
# August is NOT a single API key — see packages/integrations/src/august/README.md.
# Don't fill these in by hand: run `pnpm --filter @stayw/integrations exec tsx
# src/august/scripts/login.ts` locally, which performs the one-time
# interactive 2FA login and writes these three for you.
AUGUST_IDENTIFIER=""
AUGUST_INSTALL_ID=""
AUGUST_ACCESS_TOKEN=""
# Which account brand this login was matched against — one of "august",
# "yale_access", "yale_august", "yale_global" (see AUGUST_BRAND_CONFIGS in
# packages/integrations/src/august/types.ts). Different real accounts need
# different API keys/hosts/headers even though the rest of the request is
# identical. Written automatically by the login script; don't guess this by
# hand.
AUGUST_BRAND=""
# Maps each August lock's houseId to a StayWhile property ID — there's no
# verified way to look this up automatically (see the August README). JSON
# object, e.g. {"<houseId>":"<propertyId>"}. Run a sync once with this left
# empty to see which house IDs your locks actually have.
AUGUST_PROPERTY_MAP="{}"
# Specific August lock IDs to exclude from the sync entirely — for known
# non-lock entries (e.g. a WiFi Bridge/Connect hub) that appear in the same
# account alongside real locks. JSON array, e.g. ["<lockId>"]. Confirmed
# per-device before being added here, never guessed from a heuristic.
AUGUST_EXCLUDED_LOCK_IDS="[]"
# Nest is NOT a single API key — it's OAuth 2.0 via Google's Smart Device
# Management API (Device Access registration + OAuth client + Partner
# Connections Manager consent). See packages/integrations/src/nest/README.md.
NEST_CLIENT_ID=""
NEST_CLIENT_SECRET=""
NEST_PROJECT_ID=""
NEST_REFRESH_TOKEN=""
ECOBEE_API_KEY=""
# Cielo is NOT a single API key either — see packages/integrations/src/cielo/README.md.
# Real (verified) auth is account email/password.
CIELO_USERNAME=""
CIELO_PASSWORD=""
# Maps each Cielo device's MAC address to a StayWhile property ID — same
# reasoning as AUGUST_PROPERTY_MAP above. JSON object, e.g.
# {"<macAddress>":"<propertyId>"}.
CIELO_PROPERTY_MAP="{}"

# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
